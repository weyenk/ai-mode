#!/usr/bin/env python3
"""ai-mode — switch and manage llama-server profile presets system-wide.

Profiles are discovered from PRESETS_DIR as <name>.ini files.
Optional <name>.mode sidecars hold port/models-max/description.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

APP = "ai-mode"
HOME = Path.home()
DEFAULT_PRESETS = HOME / "models" / "presets"
CONFIG_DIR = Path(os.environ.get("AI_MODE_CONFIG", HOME / ".config" / "ai-mode"))
STATE_DIR = Path(os.environ.get("AI_MODE_STATE", HOME / ".local" / "state" / "ai-mode"))
STATE_FILE = STATE_DIR / "state.json"
ACTIVE_ENV = CONFIG_DIR / "active.env"
LOG_DIR = STATE_DIR / "logs"


# ---------------------------------------------------------------------------
# Paths / IO
# ---------------------------------------------------------------------------

def _config_value(key: str) -> str | None:
    cfg = CONFIG_DIR / "config"
    if not cfg.is_file():
        return None
    for raw in cfg.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        if k.strip() == key:
            return v.strip().strip("\"'")
    return None


def presets_dir() -> Path:
    env = os.environ.get("AI_MODE_PRESETS") or _config_value("AI_MODE_PRESETS")
    if env:
        return Path(env).expanduser()
    # Repo layout: <repo>/bin/ai-mode → <repo>/presets
    sibling = Path(__file__).resolve().parent.parent / "presets"
    if sibling.is_dir() and any(sibling.glob("*.ini")):
        return sibling
    return DEFAULT_PRESETS


def agents_dir() -> Path:
    return presets_dir() / "agents"


def parse_agent_file(path: Path) -> tuple[dict[str, str], str]:
    """Return (frontmatter, body) for agents/<role>.md."""
    text = path.read_text()
    meta: dict[str, str] = {}
    if text.startswith("---"):
        parts = text.split("---", 2)
        if len(parts) >= 3:
            for raw in parts[1].splitlines():
                line = raw.strip()
                if not line or ":" not in line:
                    continue
                k, _, v = line.partition(":")
                meta[k.strip()] = v.strip().strip("\"'")
            return meta, parts[2].lstrip("\n")
    return meta, text


def resolve_agent_file(role: str, *, _seen: frozenset[str] | None = None) -> Path:
    """Follow alias_of in frontmatter to the canonical agents/<role>.md."""
    seen = _seen or frozenset()
    if role in seen:
        raise SystemExit(f"agent alias cycle involving '{role}'")
    path = agents_dir() / f"{role}.md"
    if not path.is_file():
        return path
    meta, _ = parse_agent_file(path)
    target = meta.get("alias_of", "").strip()
    if not target or target == role:
        return path
    return resolve_agent_file(target, _seen=seen | {role})


def ensure_dirs() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)


def load_state() -> dict[str, Any]:
    ensure_dirs()
    if not STATE_FILE.exists():
        return {}
    try:
        return json.loads(STATE_FILE.read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def save_state(state: dict[str, Any]) -> None:
    ensure_dirs()
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")


def parse_mode_file(path: Path) -> dict[str, str]:
    """Parse simple key = value (.mode) files. Comments (# or ;) ignored."""
    out: dict[str, str] = {}
    if not path.exists():
        return out
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or line.startswith(";"):
            continue
        if "=" not in line:
            continue
        key, _, value = line.partition("=")
        out[key.strip().lower().replace("_", "-")] = value.strip().strip("\"'")
    return out


@dataclass
class Profile:
    name: str
    ini: Path
    mode: Path | None
    description: str
    host: str
    port: int
    models_max: int

    @property
    def base_url(self) -> str:
        return f"http://{self.host}:{self.port}/v1"

    @property
    def log_file(self) -> Path:
        return LOG_DIR / f"{self.name}.log"


def discover_profiles() -> list[Profile]:
    root = presets_dir()
    if not root.is_dir():
        return []

    inis = sorted(root.glob("*.ini"))
    profiles: list[Profile] = []
    used_ports: set[int] = set()

    for ini in inis:
        name = ini.stem
        meta = parse_mode_file(root / f"{name}.mode")
        mode_path = root / f"{name}.mode"
        port = int(meta.get("port", "0") or 0)
        if port <= 0:
            # Stable auto-port from sorted index starting at 8080
            port = 8080 + len(profiles)
            while port in used_ports:
                port += 1
        used_ports.add(port)
        profiles.append(
            Profile(
                name=name,
                ini=ini.resolve(),
                mode=mode_path.resolve() if mode_path.exists() else None,
                description=meta.get("description", ""),
                host=meta.get("host", "127.0.0.1"),
                port=port,
                models_max=int(meta.get("models-max", meta.get("models_max", "2")) or 2),
            )
        )
    return profiles


def get_profile(name: str) -> Profile | None:
    name = name.strip()
    for p in discover_profiles():
        if p.name == name:
            return p
    return None


# ---------------------------------------------------------------------------
# Process helpers
# ---------------------------------------------------------------------------

def pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def port_open(host: str, port: int, timeout: float = 0.4) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def http_get_json(url: str, timeout: float = 3.0) -> Any | None:
    try:
        req = urllib.request.Request(url, headers={"User-Agent": APP})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode())
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, json.JSONDecodeError, OSError):
        return None


def http_post_json(
    url: str,
    body: dict[str, Any],
    timeout: float = 600.0,
) -> tuple[Any | None, str | None]:
    """POST JSON; return (parsed_body, error_message)."""
    try:
        payload = json.dumps(body).encode()
        req = urllib.request.Request(
            url,
            data=payload,
            headers={"Content-Type": "application/json", "User-Agent": APP},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode()), None
    except urllib.error.HTTPError as e:
        try:
            detail = e.read().decode(errors="replace")[:500]
        except OSError:
            detail = str(e)
        return None, f"HTTP {e.code}: {detail}"
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as e:
        return None, str(e)


def find_llama_server() -> str | None:
    # Prefer a source-built HEAD under ~/.local (newer than Homebrew bottles).
    for candidate in (
        HOME / ".local" / "bin" / "llama-server",
        "/opt/homebrew/bin/llama-server",
        "/usr/local/bin/llama-server",
    ):
        p = Path(candidate)
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    which = subprocess.run(["which", "llama-server"], capture_output=True, text=True)
    if which.returncode == 0 and which.stdout.strip():
        return which.stdout.strip()
    return None


def managed_pid(state: dict[str, Any]) -> int | None:
    pid = state.get("pid")
    if isinstance(pid, int) and pid_alive(pid):
        return pid
    return None


def stop_managed(state: dict[str, Any], wait: float = 8.0) -> bool:
    """Stop the ai-mode-managed llama-server. Returns True if stopped/absent."""
    pid = state.get("pid")
    if not isinstance(pid, int) or not pid_alive(pid):
        state.pop("pid", None)
        save_state(state)
        return True

    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        state.pop("pid", None)
        save_state(state)
        return True

    deadline = time.time() + wait
    while time.time() < deadline:
        if not pid_alive(pid):
            state.pop("pid", None)
            save_state(state)
            return True
        time.sleep(0.15)

    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    time.sleep(0.2)
    dead = not pid_alive(pid)
    if dead:
        state.pop("pid", None)
        save_state(state)
    return dead


def write_active_env(profile: Profile) -> None:
    ensure_dirs()
    content = f"""# Generated by {APP} — do not edit by hand
# Active profile: {profile.name}
# Sourced automatically is optional; prefer: eval "$({APP} env)"
export AI_MODE_PROFILE={profile.name}
export AI_MODE_PORT={profile.port}
export AI_MODE_HOST={profile.host}
export AI_MODE_BASE_URL={profile.base_url}
export OPENAI_BASE_URL={profile.base_url}
export OPENAI_API_KEY=${{OPENAI_API_KEY:-local}}
"""
    ACTIVE_ENV.write_text(content)


def start_profile(profile: Profile) -> int:
    llama = find_llama_server()
    if not llama:
        raise SystemExit("llama-server not found on PATH (brew install llama.cpp?)")

    if not profile.ini.is_file():
        raise SystemExit(f"preset missing: {profile.ini}")

    if port_open(profile.host, profile.port):
        raise SystemExit(
            f"port {profile.port} already in use on {profile.host}.\n"
            f"Stop the other process or change port in {profile.name}.mode"
        )

    ensure_dirs()
    log_path = profile.log_file
    cmd = [
        llama,
        "--models-preset",
        str(profile.ini),
        "--models-max",
        str(profile.models_max),
        "--host",
        profile.host,
        "--port",
        str(profile.port),
        "--jinja",
    ]

    log_f = open(log_path, "a", encoding="utf-8")
    log_f.write(f"\n===== {APP} start {datetime.now(timezone.utc).isoformat()} =====\n")
    log_f.write(" ".join(cmd) + "\n")
    log_f.flush()

    proc = subprocess.Popen(
        cmd,
        stdout=log_f,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        cwd=str(presets_dir()),
    )
    return proc.pid


def wait_healthy(profile: Profile, timeout: float = 45.0) -> bool:
    deadline = time.time() + timeout
    url = f"{profile.base_url}/models"
    while time.time() < deadline:
        if http_get_json(url, timeout=1.5) is not None:
            return True
        time.sleep(0.4)
    return False


def ini_sections(ini: Path) -> list[str]:
    names: list[str] = []
    for line in ini.read_text().splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]") and s != "[*]":
            names.append(s[1:-1])
    return names


SYSTEMONE_WARM_BODY: dict[str, Any] = {
    "state": "ping",
    "questions": {
        "route": {
            "type": "choice",
            "instructions": "pick",
            "criteria": {"coder": None, "chief": None},
        }
    },
}


def mode_meta(profile: Profile) -> dict[str, str]:
    if profile.mode and profile.mode.is_file():
        return parse_mode_file(profile.mode)
    return {}


def resolve_warm_list(profile: Profile) -> list[str]:
    """Models to prefetch: explicit warm= in .mode, else orchestration core in ini."""
    meta = mode_meta(profile)
    if "warm" in meta:
        raw = meta["warm"]
        if not raw.strip():
            return []
        return [p.strip() for p in raw.split(",") if p.strip()]
    sections = set(ini_sections(profile.ini))
    out: list[str] = []
    for name in ("chief", "jev", "architect"):
        if name in sections:
            out.append(name)
    return out


def resolve_warm_all(profile: Profile) -> list[str]:
    """Every named preset section (excluding [*]), in ini order."""
    return ini_sections(profile.ini)


def fetch_model_catalog(profile: Profile, timeout: float = 5.0) -> dict[str, dict[str, Any]]:
    data = http_get_json(f"{profile.base_url}/models", timeout=timeout)
    if not isinstance(data, dict):
        return {}
    catalog: dict[str, dict[str, Any]] = {}
    for entry in data.get("data", []):
        if isinstance(entry, dict) and entry.get("id"):
            catalog[str(entry["id"])] = entry
    return catalog


def model_status_value(entry: dict[str, Any] | None) -> str | None:
    if not entry:
        return None
    status = entry.get("status")
    if isinstance(status, dict):
        val = status.get("value")
        return str(val) if val is not None else None
    return None


def model_is_decision(entry: dict[str, Any]) -> bool:
    arch = entry.get("architecture")
    if isinstance(arch, dict):
        outs = arch.get("output_modalities")
        if isinstance(outs, list) and "decisions" in outs:
            return True
    return str(entry.get("id", "")).lower() == "jev"


def _trigger_model_load(profile: Profile, model_id: str, is_decision: bool, timeout: float) -> str | None:
    if is_decision:
        body = {**SYSTEMONE_WARM_BODY, "model": model_id}
        _, err = http_post_json(f"{profile.base_url}/systemone", body, timeout=timeout)
        return err
    body = {
        "model": model_id,
        "messages": [{"role": "user", "content": "ping"}],
        "max_tokens": 1,
    }
    _, err = http_post_json(f"{profile.base_url}/chat/completions", body, timeout=timeout)
    return err


def warm_one_model(
    profile: Profile,
    model_id: str,
    timeout: float,
    catalog: dict[str, dict[str, Any]] | None = None,
) -> bool:
    """Load/download one preset model until status=loaded or timeout."""
    if catalog is None:
        catalog = fetch_model_catalog(profile)
    entry = catalog.get(model_id)
    if entry is None:
        # Catalog can lag right after router start; refresh once before giving up.
        catalog = fetch_model_catalog(profile, timeout=5.0)
        entry = catalog.get(model_id)
    if entry is None:
        print(f"  {model_id}: failed (not in preset /v1/models)", file=sys.stderr)
        return False

    st = model_status_value(entry)
    if st == "loaded":
        print(f"  {model_id}: ready")
        return True

    is_decision = model_is_decision(entry)
    probe = "systemone" if is_decision else "completions"
    print(f"  {model_id}: warming via {probe}…", flush=True)

    err_holder: list[str] = []

    def run_probe() -> None:
        err = _trigger_model_load(profile, model_id, is_decision, timeout=timeout)
        if err:
            err_holder.append(err)

    # Run probe in background; poll /models for download/load progress.
    probe_thread = threading.Thread(target=run_probe, daemon=True)
    probe_thread.start()

    deadline = time.time() + timeout
    last: str | None = st
    while time.time() < deadline:
        live = fetch_model_catalog(profile, timeout=3.0)
        st = model_status_value(live.get(model_id))
        if st == "loaded":
            print(f"  {model_id}: ready")
            probe_thread.join(timeout=2.0)
            return True
        if st and st != last:
            if st == "loading":
                print(f"  {model_id}: loading…", flush=True)
            elif st == "unloaded":
                print(f"  {model_id}: waiting for download…", flush=True)
            last = st
        if (
            not probe_thread.is_alive()
            and err_holder
            and st not in ("loaded", "loading")
        ):
            print(f"  {model_id}: failed ({err_holder[0]})", file=sys.stderr)
            return False
        time.sleep(1.2)

    print(f"  {model_id}: failed (timeout after {int(timeout)}s)", file=sys.stderr)
    return False


def warm_models(profile: Profile, names: list[str], timeout: float) -> int:
    """Warm models sequentially (safe for models-max). Returns exit code."""
    if not names:
        print("No models configured to warm for this profile.")
        return 0

    if http_get_json(f"{profile.base_url}/models", timeout=3.0) is None:
        print(f"Router not reachable at {profile.base_url}", file=sys.stderr)
        return 1

    nmax = profile.models_max
    if len(names) > nmax:
        print(
            f"Note: models-max={nmax} — only {nmax} model(s) stay loaded at once; "
            "sequential warm still downloads/prefetches weights for faster later requests.",
            flush=True,
        )

    catalog = fetch_model_catalog(profile)
    failed: list[str] = []
    total = len(names)
    print(f"Warming {total} model(s) on {profile.base_url}…")
    for i, model_id in enumerate(names, start=1):
        print(f"[{i}/{total}]", flush=True)
        if not warm_one_model(profile, model_id, timeout=timeout, catalog=catalog):
            failed.append(model_id)
        catalog = fetch_model_catalog(profile)

    if failed:
        print(f"Warm failed: {', '.join(failed)}", file=sys.stderr)
        return 1
    print("All models ready.")
    return 0


def maybe_warm_after_use(profile: Profile, args: argparse.Namespace) -> None:
    if getattr(args, "no_warm", False):
        return
    names = resolve_warm_list(profile)
    if not names:
        return
    warm_timeout = float(getattr(args, "warm_timeout", 600.0))
    print()
    code = warm_models(profile, names, timeout=warm_timeout)
    if code != 0:
        print("Warm incomplete — first requests may still download HF weights.", file=sys.stderr)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_list(_: argparse.Namespace) -> int:
    profiles = discover_profiles()
    state = load_state()
    active = state.get("profile")
    root = presets_dir()
    if not profiles:
        print(f"No profiles found in {root}")
        print("Add a <name>.ini (optional <name>.mode for port/description).")
        return 1

    print(f"Presets: {root}")
    print()
    for p in profiles:
        mark = "*" if p.name == active else " "
        desc = f"  — {p.description}" if p.description else ""
        mode = "mode" if p.mode else "auto-port"
        print(f" {mark} {p.name:<20} :{p.port:<5} [{mode}]{desc}")
    print()
    print("* = active profile (ai-mode use)")
    return 0


def cmd_which(args: argparse.Namespace) -> int:
    state = load_state()
    profile_name = state.get("profile")
    if not profile_name:
        print("No active profile. Run: ai-mode use <name>")
        return 1

    profile = get_profile(profile_name)
    pid = managed_pid(state)
    running = bool(pid) and profile is not None and port_open(profile.host, profile.port)

    if args.json:
        payload = {
            "profile": profile_name,
            "pid": pid,
            "running": running,
            "base_url": profile.base_url if profile else None,
            "port": profile.port if profile else state.get("port"),
            "host": profile.host if profile else state.get("host"),
            "ini": str(profile.ini) if profile else state.get("ini"),
            "started_at": state.get("started_at"),
        }
        print(json.dumps(payload, indent=2))
        return 0

    print(f"profile:  {profile_name}")
    if profile:
        print(f"base_url: {profile.base_url}")
        print(f"port:     {profile.port}")
        print(f"ini:      {profile.ini}")
        if profile.description:
            print(f"about:    {profile.description}")
    print(f"pid:      {pid or '—'}")
    print(f"server:   {'running' if running else 'stopped'}")
    if state.get("started_at"):
        print(f"started:  {state['started_at']}")
    return 0 if running else 2


def cmd_use(args: argparse.Namespace) -> int:
    name = args.profile
    profile = get_profile(name)
    if not profile:
        available = ", ".join(p.name for p in discover_profiles()) or "(none)"
        print(f"Unknown profile: {name}")
        print(f"Available: {available}")
        return 1

    state = load_state()
    current = state.get("profile")
    pid = managed_pid(state)

    if (
        not args.force
        and current == profile.name
        and pid
        and port_open(profile.host, profile.port)
        and http_get_json(f"{profile.base_url}/models", timeout=2) is not None
    ):
        print(f"Already using {profile.name} at {profile.base_url}")
        write_active_env(profile)
        maybe_warm_after_use(profile, args)
        return 0

    if pid or state.get("pid"):
        print(f"Stopping {current or 'previous'} (pid {state.get('pid')})…")
        if not stop_managed(state):
            print("Failed to stop previous llama-server; try: ai-mode stop --force", file=sys.stderr)
            return 1
        state = load_state()

    # If something else holds our target port, refuse
    if port_open(profile.host, profile.port):
        print(
            f"Port {profile.port} is busy but not owned by ai-mode.\n"
            f"Free it or edit {profile.name}.mode",
            file=sys.stderr,
        )
        return 1

    print(f"Starting {profile.name} on {profile.base_url}…")
    try:
        pid = start_profile(profile)
    except SystemExit as e:
        print(e, file=sys.stderr)
        return 1

    state = {
        "profile": profile.name,
        "pid": pid,
        "port": profile.port,
        "host": profile.host,
        "ini": str(profile.ini),
        "started_at": datetime.now(timezone.utc).isoformat(),
        "log": str(profile.log_file),
    }
    save_state(state)
    write_active_env(profile)

    print(f"pid {pid}; waiting for health…")
    # First model load can take a while; router itself should answer /v1/models sooner
    if wait_healthy(profile, timeout=float(args.timeout)):
        models = http_get_json(f"{profile.base_url}/models") or {}
        ids = [m.get("id") for m in models.get("data", []) if isinstance(m, dict)]
        print(f"Active: {profile.name} → {profile.base_url}")
        if ids:
            print(f"Models ({len(ids)}): {', '.join(ids[:12])}{'…' if len(ids) > 12 else ''}")
        print(f"Env:    eval \"$(ai-mode env)\"")
        print(f"Logs:   ai-mode logs")
        maybe_warm_after_use(profile, args)
        return 0

    print(
        f"Server started (pid {pid}) but /v1/models not healthy yet.\n"
        f"Check: ai-mode logs -f\n"
        f"Log:   {profile.log_file}",
        file=sys.stderr,
    )
    return 2


def cmd_stop(args: argparse.Namespace) -> int:
    state = load_state()
    if not state.get("pid") and not state.get("profile"):
        print("Nothing to stop.")
        return 0
    profile = state.get("profile", "?")
    pid = state.get("pid")
    print(f"Stopping {profile} (pid {pid})…")
    ok = stop_managed(state, wait=12.0 if args.force else 8.0)
    if not ok and args.force and isinstance(pid, int):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        state = load_state()
        state.pop("pid", None)
        save_state(state)
        ok = True
    # Keep profile name so `which` still shows last selection, but mark stopped
    print("Stopped." if ok else "Failed to stop.")
    return 0 if ok else 1


def cmd_restart(args: argparse.Namespace) -> int:
    state = load_state()
    name = args.profile or state.get("profile")
    if not name:
        print("No profile to restart. Use: ai-mode use <name>")
        return 1
    ns = argparse.Namespace(
        profile=name,
        force=True,
        timeout=args.timeout,
        no_warm=getattr(args, "no_warm", False),
        warm_timeout=getattr(args, "warm_timeout", 600.0),
    )
    # stop first (use will also stop)
    cmd_stop(argparse.Namespace(force=False))
    return cmd_use(ns)


def cmd_doctor(_: argparse.Namespace) -> int:
    ensure_dirs()
    root = presets_dir()
    profiles = discover_profiles()
    state = load_state()
    llama = find_llama_server()
    issues: list[str] = []

    print(f"{APP} doctor")
    print("=" * 40)
    print(f"presets dir:  {root}{'  OK' if root.is_dir() else '  MISSING'}")
    if not root.is_dir():
        issues.append(f"Create {root} and add <name>.ini profiles")

    print(f"llama-server: {llama or 'NOT FOUND'}")
    if not llama:
        issues.append("Install llama.cpp (brew install llama.cpp)")
    else:
        ver = subprocess.run([llama, "--version"], capture_output=True, text=True)
        ver_line = (ver.stdout or ver.stderr or "").strip().splitlines()[:1]
        if ver_line:
            print(f"version:      {ver_line[0]}")
        # Decision models (Jev) need /v1/systemone in the server binary
        try:
            impl = Path(llama).resolve().parent.parent / "lib" / "libllama-server-impl.dylib"
            has_systemone = False
            if impl.is_file():
                probed = subprocess.run(
                    ["strings", str(impl)], capture_output=True, text=True, timeout=10
                )
                has_systemone = "/v1/systemone" in (probed.stdout or "")
            else:
                probed = subprocess.run(
                    ["strings", llama], capture_output=True, text=True, timeout=10
                )
                has_systemone = "/v1/systemone" in (probed.stdout or "")
            print(f"/v1/systemone: {'OK (Jev/Kev ready)' if has_systemone else 'MISSING'}")
            if not has_systemone:
                issues.append(
                    "llama-server lacks /v1/systemone — upgrade llama.cpp (brew install --HEAD llama.cpp) for jev/Kev-4B"
                )
        except Exception as e:
            print(f"/v1/systemone: could not probe ({e})")

    print(f"config:       {CONFIG_DIR}")
    print(f"state:        {STATE_FILE}{'  (present)' if STATE_FILE.exists() else '  (empty)'}")
    print(f"active.env:   {ACTIVE_ENV}{'  OK' if ACTIVE_ENV.exists() else '  (none yet)'}")
    print()

    if not profiles:
        issues.append("No *.ini profiles discovered")
    else:
        print(f"Profiles ({len(profiles)}):")
        ports: dict[int, str] = {}
        for p in profiles:
            clash = ""
            if p.port in ports:
                clash = f"  PORT CLASH with {ports[p.port]}"
                issues.append(f"Port clash: {p.name} and {ports[p.port]} both use {p.port}")
            ports[p.port] = p.name
            mode = "✓ .mode" if p.mode else "○ auto-port"
            sections = ini_sections(p.ini)
            print(f"  • {p.name}")
            print(f"      {mode}  {p.host}:{p.port}  models-max={p.models_max}")
            print(f"      ini models: {', '.join(sections) if sections else '(none)'}")
            if clash:
                print(f"      {clash.strip()}")
            if not p.ini.is_file():
                issues.append(f"Missing ini for {p.name}")
            # Agent guide coverage
            missing_agents = [
                role
                for role in ini_sections(p.ini)
                if not (agents_dir() / f"{role}.md").is_file()
            ]
            if missing_agents:
                issues.append(
                    f"{p.name}: missing agents/*.md for: {', '.join(missing_agents)}"
                )
            else:
                print(f"      agents: OK ({len(ini_sections(p.ini))} roles)")

    print()
    active = state.get("profile")
    pid = managed_pid(state)
    print(f"Active profile: {active or '—'}")
    print(f"Managed pid:    {pid or '—'}")
    if active:
        p = get_profile(active)
        if p:
            up = port_open(p.host, p.port)
            health = http_get_json(f"{p.base_url}/models") if up else None
            print(f"Port open:      {up}")
            print(f"API /models:    {'OK' if health is not None else 'FAIL'}")
            if up and health is None:
                issues.append(f"{active} port is open but /v1/models failed — check ai-mode logs")
            if pid and not up:
                issues.append(f"pid {pid} alive but port {p.port} closed — stale state?")
            if not pid and up:
                issues.append(f"port {p.port} open but not ai-mode-managed (foreign process?)")
        else:
            issues.append(f"Active profile '{active}' has no matching .ini anymore")

    # PATH check
    local_bin = HOME / ".local" / "bin"
    path = os.environ.get("PATH", "")
    on_path = str(local_bin) in path.split(":")
    print(f"~/.local/bin on PATH: {'yes' if on_path else 'NO'}")
    if not on_path:
        issues.append("Add ~/.local/bin to PATH so `ai-mode` works in every shell")

    print()
    if issues:
        print("Issues:")
        for i in issues:
            print(f"  ✗ {i}")
        return 1
    print("All checks passed.")
    return 0


def cmd_env(args: argparse.Namespace) -> int:
    state = load_state()
    name = args.profile or state.get("profile")
    if not name:
        print("# no active profile", file=sys.stderr)
        return 1
    profile = get_profile(name)
    if not profile:
        print(f"# unknown profile: {name}", file=sys.stderr)
        return 1
    write_active_env(profile)
    # Print for eval "$(ai-mode env)"
    print(f'export AI_MODE_PROFILE="{profile.name}"')
    print(f'export AI_MODE_PORT="{profile.port}"')
    print(f'export AI_MODE_HOST="{profile.host}"')
    print(f'export AI_MODE_BASE_URL="{profile.base_url}"')
    print(f'export OPENAI_BASE_URL="{profile.base_url}"')
    print('export OPENAI_API_KEY="${OPENAI_API_KEY:-local}"')
    return 0


def cmd_logs(args: argparse.Namespace) -> int:
    state = load_state()
    name = args.profile or state.get("profile")
    if not name:
        print("No active profile.", file=sys.stderr)
        return 1
    profile = get_profile(name)
    log = profile.log_file if profile else LOG_DIR / f"{name}.log"
    if not log.exists():
        print(f"No log yet: {log}", file=sys.stderr)
        return 1
    if args.follow:
        subprocess.run(["tail", "-n", str(args.lines), "-f", str(log)])
        return 0
    subprocess.run(["tail", "-n", str(args.lines), str(log)])
    return 0


def cmd_url(_: argparse.Namespace) -> int:
    state = load_state()
    name = state.get("profile")
    if not name:
        print("No active profile.", file=sys.stderr)
        return 1
    profile = get_profile(name)
    if not profile:
        print(f"Unknown profile: {name}", file=sys.stderr)
        return 1
    print(profile.base_url)
    return 0


def cmd_warm(args: argparse.Namespace) -> int:
    state = load_state()
    name = args.profile or state.get("profile")
    if not name:
        print("No active profile. Use: ai-mode use <name> or ai-mode warm --profile <name>", file=sys.stderr)
        return 1
    profile = get_profile(name)
    if not profile:
        print(f"Unknown profile: {name}", file=sys.stderr)
        return 1

    if getattr(args, "all", False):
        if args.models:
            print("Ignoring positional models (--all warms every ini section).", file=sys.stderr)
        names = resolve_warm_all(profile)
    elif args.models:
        names = list(args.models)
    else:
        names = resolve_warm_list(profile)
    return warm_models(profile, names, timeout=float(args.warm_timeout))


def cmd_models(_: argparse.Namespace) -> int:
    state = load_state()
    name = state.get("profile")
    if not name:
        print("No active profile.", file=sys.stderr)
        return 1
    profile = get_profile(name)
    if not profile:
        print(f"Unknown profile: {name}", file=sys.stderr)
        return 1
    data = http_get_json(f"{profile.base_url}/models")
    if data is None:
        print(f"API not reachable at {profile.base_url}", file=sys.stderr)
        return 1
    for m in data.get("data", []):
        print(m.get("id", "?"))
    # Also show configured ini sections (may not be loaded yet)
    print("---", file=sys.stderr)
    print("configured in preset:", file=sys.stderr)
    for s in ini_sections(profile.ini):
        print(f"  {s}", file=sys.stderr)
    return 0


def cmd_init_mode(args: argparse.Namespace) -> int:
    """Create a .mode sidecar for a profile (or scaffold both)."""
    root = presets_dir()
    root.mkdir(parents=True, exist_ok=True)
    name = args.profile
    ini = root / f"{name}.ini"
    mode = root / f"{name}.mode"

    if args.with_ini and not ini.exists():
        ini.write_text(
            f"""; {name} — llama-server router preset
version = 1

[*]
jinja = 1
flash-attn = on
n-gpu-layers = 99
load-mode = mmap

; [example]
; hf = unsloth/Qwen3-4B-GGUF:Q4_K_M
; ctx-size = 16384
"""
        )
        print(f"Created {ini}")

    if mode.exists() and not args.force:
        print(f"Already exists: {mode} (use --force to overwrite)")
        return 1

    # Pick a free-ish default port
    used = {p.port for p in discover_profiles() if p.name != name}
    port = args.port
    if port <= 0:
        port = 8080
        while port in used:
            port += 1

    mode.write_text(
        f"""# ai-mode metadata for profile "{name}"
description = {args.description or name}
port = {port}
models-max = {args.models_max}
host = 127.0.0.1
# warm = chief,jev,architect
"""
    )
    print(f"Created {mode}")
    print(f"Edit models in: {ini}")
    return 0


def cmd_agents(args: argparse.Namespace) -> int:
    adir = agents_dir()
    if not adir.is_dir():
        print(f"No agents directory at {adir}")
        return 1
    files = sorted(adir.glob("*.md"))
    files = [f for f in files if f.name.lower() != "readme.md"]
    if not files:
        print(f"No agent guides in {adir}")
        return 1

    # Map roles declared in presets
    role_profiles: dict[str, list[str]] = {}
    for p in discover_profiles():
        for role in ini_sections(p.ini):
            role_profiles.setdefault(role, []).append(p.name)

    print(f"Agents: {adir}")
    print()
    for f in files:
        meta, _ = parse_agent_file(f)
        role = meta.get("role") or f.stem
        profile = meta.get("profile") or ",".join(role_profiles.get(role, [])) or "?"
        trigger = meta.get("trigger")
        mark = ""
        if args.profile and profile != args.profile and args.profile not in role_profiles.get(role, []):
            continue
        line = f"  {role:<18} profile={profile}"
        if trigger:
            line += f"  trigger={trigger}"
        if role not in role_profiles:
            line += "  (no matching ini section)"
        print(line + mark)
    return 0


def cmd_prompt(args: argparse.Namespace) -> int:
    role = args.role
    stub = agents_dir() / f"{role}.md"
    if not stub.is_file():
        available = sorted(
            p.stem for p in agents_dir().glob("*.md") if p.name.lower() != "readme.md"
        ) if agents_dir().is_dir() else []
        print(f"No agent guide for '{role}'", file=sys.stderr)
        if available:
            print("Available:", ", ".join(available), file=sys.stderr)
        return 1
    path = resolve_agent_file(role)
    if not path.is_file():
        print(f"No agent guide for alias target of '{role}'", file=sys.stderr)
        return 1
    meta, body = parse_agent_file(path)
    if args.json:
        print(json.dumps({"role": role, "path": str(path), "meta": meta, "prompt": body}, indent=2))
        return 0
    if args.raw:
        print(path.read_text(), end="" if path.read_text().endswith("\n") else "\n")
        return 0
    # Default: body only (ideal system prompt)
    sys.stdout.write(body if body.endswith("\n") else body + "\n")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=APP,
        description="Switch and manage llama-server AI profile presets",
    )
    p.add_argument(
        "--presets",
        help=f"Presets directory (default: {DEFAULT_PRESETS} or $AI_MODE_PRESETS)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="List discovered profiles")

    w = sub.add_parser("which", help="Show active profile")
    w.add_argument("--json", action="store_true")

    u = sub.add_parser("use", help="Activate a profile (start llama-server)")
    u.add_argument("profile")
    u.add_argument("--force", action="store_true", help="Restart even if already active")
    u.add_argument("--timeout", type=float, default=60.0, help="Health wait seconds")
    u.add_argument("--no-warm", action="store_true", help="Skip prefetch after router is healthy")
    u.add_argument(
        "--warm-timeout",
        type=float,
        default=600.0,
        help="Seconds to wait per model during warm (HF download)",
    )

    wm = sub.add_parser(
        "warm",
        help="Prefetch/load models on the active router (sequential; probes /chat/completions or /systemone)",
    )
    wm.add_argument(
        "models",
        nargs="*",
        help="Role ids from preset ini (default: warm= in .mode, else chief+jev+architect)",
    )
    wm.add_argument("--profile", help="Profile (default: active)")
    wm.add_argument(
        "--all",
        action="store_true",
        help="Warm every ini section (except [*]); with models-max only N stay loaded",
    )
    wm.add_argument(
        "--warm-timeout",
        type=float,
        default=600.0,
        help="Seconds to wait per model (HF download)",
    )

    st = sub.add_parser("stop", help="Stop the managed server")
    st.add_argument("--force", action="store_true", help="SIGKILL if needed")

    r = sub.add_parser("restart", help="Restart active (or named) profile")
    r.add_argument("profile", nargs="?")
    r.add_argument("--timeout", type=float, default=60.0)
    r.add_argument("--no-warm", action="store_true", help="Skip prefetch after restart")
    r.add_argument(
        "--warm-timeout",
        type=float,
        default=600.0,
        help="Seconds to wait per model during warm",
    )

    sub.add_parser("doctor", help="Check install, profiles, and server health")
    sub.add_parser("status", help="Alias for which")

    e = sub.add_parser("env", help="Print shell exports for eval \"$(ai-mode env)\"")
    e.add_argument("profile", nargs="?", help="Profile (default: active)")

    lg = sub.add_parser("logs", help="Tail profile logs")
    lg.add_argument("profile", nargs="?")
    lg.add_argument("-f", "--follow", action="store_true")
    lg.add_argument("-n", "--lines", type=int, default=80)

    sub.add_parser("url", help="Print active OpenAI base URL")
    sub.add_parser("models", help="List models from the active server")

    im = sub.add_parser("init", help="Scaffold a new profile (.mode and optional .ini)")
    im.add_argument("profile")
    im.add_argument("--port", type=int, default=0)
    im.add_argument("--models-max", type=int, default=2)
    im.add_argument("--description", default="")
    im.add_argument("--with-ini", action="store_true", help="Also create a starter .ini")
    im.add_argument("--force", action="store_true")

    ag = sub.add_parser("agents", help="List agent markdown guides")
    ag.add_argument("--profile", help="Filter by profile name")

    pr = sub.add_parser("prompt", help="Print system prompt for a role (agents/<role>.md)")
    pr.add_argument("role")
    pr.add_argument("--json", action="store_true", help="Include frontmatter + body as JSON")
    pr.add_argument("--raw", action="store_true", help="Print full markdown including frontmatter")

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.presets:
        os.environ["AI_MODE_PRESETS"] = args.presets

    cmd = args.cmd
    if cmd == "list":
        return cmd_list(args)
    if cmd in ("which", "status"):
        return cmd_which(args)
    if cmd == "use":
        return cmd_use(args)
    if cmd == "stop":
        return cmd_stop(args)
    if cmd == "restart":
        return cmd_restart(args)
    if cmd == "doctor":
        return cmd_doctor(args)
    if cmd == "env":
        return cmd_env(args)
    if cmd == "logs":
        return cmd_logs(args)
    if cmd == "url":
        return cmd_url(args)
    if cmd == "models":
        return cmd_models(args)
    if cmd == "warm":
        return cmd_warm(args)
    if cmd == "init":
        return cmd_init_mode(args)
    if cmd == "agents":
        return cmd_agents(args)
    if cmd == "prompt":
        return cmd_prompt(args)
    parser.error(f"unknown command: {cmd}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
