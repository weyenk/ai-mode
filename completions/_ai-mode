#compdef ai-mode

_ai-mode() {
  local -a cmds profiles
  cmds=(
    'list:List profiles'
    'use:Activate a profile'
    'which:Show active profile'
    'status:Alias for which'
    'stop:Stop managed server'
    'restart:Restart profile'
    'doctor:Health checks'
    'env:Print shell exports'
    'logs:Tail logs'
    'url:Print base URL'
    'models:List server models'
    'warm:Prefetch/load models'
    'init:Scaffold a new profile'
    'agents:List agent guides'
    'prompt:Print role system prompt'
    'ask:Ask a role one question'
    'team:Consult several roles on one topic'
    'setup-qwen:Install routing rules into ~/.qwen/QWEN.md'
    'plan:Lint a plan or verify a task is red then green'
    'classify:Route a task with jev (role or QA layer)'
    'review:Review real calls and label them'
    'proxy:Run the debug logging proxy (normally via use --debug)'
    'events:Show structured event log'
    'trace:Show call tree for a trace id'
    'stats:Latency/token/error stats per role'
    'ps:Loaded models with last-call info'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'ai-mode command' cmds
    return
  fi
  case $words[2] in
    use|restart|env|init|agents)
      profiles=(${(f)"$(ai-mode list 2>/dev/null | awk '/^ [* ] /{print $2}')"})
      _values 'profile' $profiles
      ;;
    logs)
      if [[ $words[CURRENT] == -* ]]; then
        _values 'option' '-f' '-n' '--no-annotate' '--role'
      elif [[ $words[CURRENT-1] == --role ]]; then
        roles=(${(f)"$(ai-mode agents 2>/dev/null | awk '/^  /{print $1}')"})
        _values 'role' $roles
      else
        profiles=(${(f)"$(ai-mode list 2>/dev/null | awk '/^ [* ] /{print $2}')"})
        _values 'profile' $profiles
      fi
      ;;
    warm)
      if (( CURRENT == 3 )); then
        _values 'option' '--all' '--profile' '--warm-timeout'
      elif (( CURRENT >= 3 )); then
        models=(${(f)"$(ai-mode models 2>/dev/null | grep -v '^---')"})
        _values 'model' $models
      fi
      ;;
    setup-qwen)
      _values 'option' '--file' '--print' '--remove'
      ;;
    prompt|ask)
      if [[ $words[CURRENT] == -* && $words[2] == ask ]]; then
        _values 'option' '--context' '--context-max-chars' '--max-tokens' '--profile' '--timeout' '--json' '--raw' '--caller' '--trace' '--parent' '-v'
      else
        roles=(${(f)"$(ai-mode agents 2>/dev/null | awk '/^  /{print $1}')"})
        _values 'role' $roles
      fi
      ;;
    plan)
      if (( CURRENT == 3 )); then
        _values 'subcommand' 'lint' 'verify'
      elif [[ $words[CURRENT] == -* ]]; then
        _values 'option' '--json' '--task' '--repo'
      else
        _files
      fi
      ;;
    team)
      if [[ $words[CURRENT] == -* ]]; then
        _values 'option' '--context' '--context-max-chars' '--roles' '--max-tokens' '--timeout' '--out' '--profile' '--caller' '--trace' '--parent' '-v'
      fi
      ;;
  esac
}
compdef _ai-mode ai-mode
